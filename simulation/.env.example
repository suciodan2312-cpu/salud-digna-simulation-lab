SIM_RATE=5
SIM_DURATION_SECONDS=60
SIM_CONCURRENCY=2
SIM_TIMEOUT_MS=8000
SIM_READ_RETRIES=1
SIM_MAX_RETRY_AFTER_MS=5000
SIM_P95_MS=500
SIM_ERROR_PERCENT=1
SIM_FRUSTRATION_INITIAL=20
SIM_FRUSTRATION_MODE=observed
SIM_FRUSTRATION_RETRIES=2
