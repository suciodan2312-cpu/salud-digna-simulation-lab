# Grafana k6
SIM_LOAD_SCENARIO=smoke
SIM_PRE_VUS=2
SIM_RAMP_SECONDS=15
SIM_STOP_DELAY_SECONDS=10
SIM_MAX_DROPPED=0
SIM_STUDY_PERCENT=50
SIM_PATIENT_READ_PERCENT=0
SIM_CITAS_PERCENT=50
SIM_FRICTION_DELAY_MS=500
# SIM_K6_CONFIRM se establece solo para una prueba local autorizada.
# SIM_CODE_REVISION y SIM_DATASET_ID identifican el reporte.
# SIM_PATIENT_TOKEN y SIM_PATIENT_EXPIRES_AT se preparan fuera de k6.
# SIM_ADVISOR_TOKEN y SIM_ADVISOR_EXPIRES_AT se preparan fuera de k6.
# SIM_ADMIN_TOKEN y SIM_ADMIN_EXPIRES_AT se preparan fuera de k6.

# Interfaces web para planificación. No se consultan.
SIM_PATIENT_PORTAL_URL=
SIM_CALL_CENTER_URL=
