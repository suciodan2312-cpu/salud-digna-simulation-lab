SIM_ORCHESTRATOR_URL=http://127.0.0.1:3300
SIM_ALLOW_WRITES=false
SIM_CONVERSATION=false
SIM_CONTINUITY=false
SIM_CHANNELS=web,whatsapp,call-center
SIM_SEED=42
SIM_RECORDS=10000
